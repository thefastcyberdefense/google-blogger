//- Representative MODELS of Blogger's default Version 2 gadget output for L1 regressions.
//- This is not Blogger-rendered output. Markup is sanitized: synthetic contributor names,
//- data: images and no production URLs. Replace these assumptions with the captured
//- native inventory skeleton (input B1) when it is available.
- var fixtureAvatar = 'data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%22113%22%20height=%22113%22%3E%3Crect%20width=%22113%22%20height=%22113%22%20fill=%22%2353627b%22/%3E%3C/svg%3E'
- var fixtureDefaultAvatar = 'data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%2216%22%20height=%2216%22%3E%3Crect%20width=%2216%22%20height=%2216%22%20fill=%22%23bccbdc%22/%3E%3C/svg%3E'

//- Saved gadgets Blogger places after Header1 inside the masthead section.
mixin fixtureSavedHeaderGadgets()
  #BlogSearch1.widget.BlogSearch(data-version='2')
    .widget-content(role='search')
      form(action='/search' target='_top')
        .search-input
          input(aria-label='Search this blog' autocomplete='off' name='q' placeholder='Search this blog' value='')
        input.search-action.flat-button(type='submit' value='Search')
  #Attribution1.widget.Attribution(data-version='2')
    .widget-content
      .blogger
        a(href='https://www.blogger.com' rel='nofollow')
          //- Unsized platform icon, as observed. The real sprite reference is replaced
          //- by an inline shape so the model makes no network request.
          svg.svg-icon-24
            rect(x='3' y='3' width='18' height='18' rx='3')
          |  Powered by Blogger
      .image-attribution
  #ReportAbuse1.widget.ReportAbuse(data-version='2')
    h3.title
      a.report_abuse(href='https://www.blogger.com/go/report-abuse' rel='noopener nofollow' target='_blank') Report Abuse
  #Profile1.widget.Profile(data-version='2')
    .widget-content
      ul
        li
          a.profile-name-link.g-profile(href='/profile/contributor-a' style='background-image:url("' + fixtureDefaultAvatar + '")') Contributor A
        li
          a.profile-name-link.g-profile(href='/profile/contributor-b')
            img.profile-img(src=fixtureAvatar width='113' height='113' alt='Profile photo')
            |  Contributor B

//- Empty native sidebar section as Blogger renders it with no widgets.
mixin fixtureEmptySidebarSection()
  #sidebar.sidebar-widgets.section.no-items

//- Native sidebar section holding BlogArchive1 with no archive data (current super.main output).
mixin fixtureEmptyArchiveSidebar()
  #sidebar.sidebar-widgets.section
    #BlogArchive1.widget.BlogArchive(data-version='2')
      .widget-content
