//- Shared presentation, not a Blogger expression interpreter. Fixture values are synthetic build-time inputs.
//- Native wrappers and data expressions remain explicit at production boundaries.
mixin fcdBrand(fixture)
  a.brand&attributes(fixture ? {href:'/', 'aria-label':'Fast Cyber Defense Blog homepage'} : {'expr:href':'data:blog.homepageUrl', 'aria-label':'Fast Cyber Defense Blog homepage'})
    span.brand-monogram(aria-hidden='true') FCD
    span.brand-name Fast Cyber Defense
      small Security publication

mixin fcdHeader(fixture = false)
  header.site-header
    .container.header-row
      if fixture
        #header.header
          #Header1.widget.Header
            +fcdBrand(true)
      else
        b:section(id='header' class='header' name='Brand' showaddelement='false')
          b:widget(id='Header1' type='Header' title='Fast Cyber Defense' version='2' locked='true')
            b:includable(id='main')
              +fcdBrand(false)
      .header-actions
        button#theme-toggle.js-control(type='button' hidden='hidden' aria-label='Switch color theme') Theme
        button#menu-toggle.js-control(type='button' hidden='hidden' aria-controls='primary-navigation' aria-expanded='false') Menu
    nav#primary-navigation.container.primary-navigation(aria-label='Primary')
      a&attributes(fixture ? {href:'/search'} : {'expr:href':'data:blog.homepageUrl path "search"'}) Latest
      a(href='#topics') Topics
      a(href='https://fastcyberdefense.com/') Company website
      form#site-search.search-form&attributes(fixture ? {action:'/search',method:'get',role:'search'} : {'expr:action':'data:blog.searchUrl',method:'get',role:'search'})
        label.sr-only(for='search-query') Search articles
        input#search-query(type='search' name='q' placeholder='Search security insights' autocomplete='off')/
        button(type='submit') Search blog

mixin fcdLabels(post, fixture)
  if fixture
    if post.labels && post.labels.length
      .post-labels
        each label in post.labels
          a(href=label.url rel='tag')= label.name
  else
    b:if(cond='data:post.labels')
      .post-labels
        b:loop(values='data:post.labels' var='label' index='li')
          b:if(cond='data:view.isSingleItem or data:li < 2')
            a(expr:href='data:label.url' rel='tag')
              b:eval(expr='data:label.name')/

mixin fcdByline(post, fixture, single)
  .byline
    if fixture
      span= post.author
      time(datetime=post.date)= post.dateLabel
      if single
        if post.updated
          span Updated
            time(datetime=post.updated)= post.updatedLabel
        span#reading-time(hidden='hidden')
    else
      b:if(cond='data:post.author.name')
        span
          b:eval(expr='data:post.author.name')/
      b:if(cond='data:post.date')
        time(expr:datetime='data:post.date.iso8601')
          b:eval(expr='data:post.date')/
      b:if(cond='data:view.isPost and data:post.lastUpdated')
        span Updated
          time(expr:datetime='data:post.lastUpdated.iso8601')
            b:eval(expr='data:post.lastUpdated')/
      b:if(cond='data:view.isPost')
        span#reading-time(hidden='hidden')

mixin fcdCardImage(post, fixture)
  a.card-image&attributes(fixture ? {href:post.url,'aria-hidden':'true',tabindex:'-1'} : {'expr:href':'data:post.url','aria-hidden':'true',tabindex:'-1'})
    img&attributes(fixture ? {src:post.image,srcset:post.image+' 400w, '+post.image+' 800w',sizes:'(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 40vw',width:'800',height:'450',alt:'',decoding:'async',loading:'lazy'} : {'expr:src':'resizeImage(data:post.featuredImage, 800, "16:9")','expr:srcset':'resizeImage(data:post.featuredImage, 400, "16:9") + " 400w, " + resizeImage(data:post.featuredImage, 800, "16:9") + " 800w"',sizes:'(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 40vw',width:'800',height:'450',alt:'',decoding:'async',loading:'lazy'})/

mixin fcdCard(post = {}, fixture = false)
  article.post-card(data-filter-card='true')
    if fixture
      if post.image
        +fcdCardImage(post, true)
    else
      b:if(cond='data:post.featuredImage')
        +fcdCardImage({}, false)
    .card-content
      +fcdLabels(post, fixture)
      h2.post-title
        a&attributes(fixture ? {href:post.url} : {'expr:href':'data:post.url'})
          if fixture
            = post.title
          else
            b:eval(expr='data:post.title')/
      p.post-excerpt
        if fixture
          = post.excerpt
        else
          b:eval(expr='snippet(data:post.snippets.long, {length: 180, links: false, linebreaks: false, ellipsis: true})')/
      +fcdByline(post, fixture, false)

mixin fcdShareAndCta(post, fixture)
  .share-actions(aria-label='Share article')
    button.js-control#copy-link(type='button' hidden='hidden') Copy article link
    a&attributes(fixture ? {href:'https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent('https://blogs.fastcyberdefense.com'+post.url),target:'_blank',rel:'noopener noreferrer'} : {'expr:href':'"https://www.linkedin.com/sharing/share-offsite/" params {url: data:post.url.canonical}',target:'_blank',rel:'noopener noreferrer'}) Share on LinkedIn
  aside.article-cta
    h2 Need help securing your organization?
    p Put knowledge into practice with Fast Cyber Defense.
    a(href='https://fastcyberdefense.com/') Explore FCD services

mixin fcdArticle(post = {}, fixture = false)
  article.article-view
    header.article-header
      +fcdLabels(post, fixture)
      h1.post-title
        if fixture
          = post.title
        else
          b:eval(expr='data:post.title')/
      +fcdByline(post, fixture, true)
      if fixture
        if post.excerpt
          p.standfirst= post.excerpt
      else
        b:if(cond='data:view.description')
          p.standfirst
            b:eval(expr='data:view.description')/
    .post-body#article-body
      if fixture
        block
      else
        b:eval(expr='data:post.body')/
    if fixture
      +fcdShareAndCta(post, true)
    else
      b:if(cond='data:view.isPost')
        +fcdShareAndCta({}, false)
