//- Shared production presentation and synthetic fixture inputs. Native expressions are not interpreted by fixtures.
mixin fcdBrand(fixture)
  a.brand(href=fixture ? '/' : undefined expr:href=fixture ? undefined : 'data:blog.homepageUrl' aria-label='Fast Cyber Defense Blog homepage')
    span.brand-monogram(aria-hidden='true') FCD
    span.brand-name Fast Cyber Defense
      small Security publication

//- L1: Theme and Menu render inside Header1 with the brand, so saved gadgets that Blogger
//- places in the masthead section can only follow the complete brand row, never split it.
mixin fcdBrandRow(fixture)
  .brand-row
    +fcdBrand(fixture)
    .header-actions
      button#theme-toggle.js-control(type='button' hidden='hidden' aria-label='Switch color theme') Theme
      button#menu-toggle.js-control(type='button' hidden='hidden' aria-controls='primary-navigation' aria-expanded='false') Menu

//- L1-nav (design v1): Navigation is the owner's Link List gadget (Layout > Navigation). Saved links
//- render in the owner's order; until any are saved, a fresh install shows the approved defaults.
mixin fcdNavDefaults(fixture)
  li.nav-item
    a.nav-link(href=fixture ? '/search' : undefined expr:href=fixture ? undefined : 'data:blog.homepageUrl path "search"') Latest
  li.nav-item
    a.nav-link(href='#topics') Topics
  li.nav-item
    a.nav-link(href=fixture ? '/search/label/Guides' : undefined expr:href=fixture ? undefined : 'data:blog.homepageUrl path "search/label/Guides"') Guides
  li.nav-item
    a.nav-link(href='https://fastcyberdefense.com/') Company website
      span.nav-external(aria-hidden='true') &#8599;

mixin fcdNavList(fixture)
  ul.nav-list
    if fixture
      +fcdNavDefaults(true)
    else
      b:if(cond='data:links')
        b:loop(values='data:links' var='link')
          li.nav-item
            a.nav-link(expr:href='data:link.target')
              b:eval(expr='data:link.name')/
        b:else/
        +fcdNavDefaults(false)

mixin fcdHeader(fixture = false)
  header.site-header
    .container.header-row
      if fixture
        #header.header
          #Header1.widget.Header
            +fcdBrandRow(true)
          //- Fixture-only hook: saved-gadget models render as Header1 siblings, as Blogger places them.
          if block
            block
      else
        b:section(id='header' class='header' name='Brand' showaddelement='false')
          b:widget(id='Header1' type='Header' title='Fast Cyber Defense' version='2' locked='true')
            b:includable(id='main')
              +fcdBrandRow(false)
      //- The theme owns the drawer Menu controls and FCD's single search; only the links are a gadget.
      nav#primary-navigation.primary-navigation(aria-label='Primary')
        if fixture
          #navigation.navigation
            #LinkList1.widget.LinkList
              +fcdNavList(true)
        else
          b:section(id='navigation' class='navigation' name='Navigation' maxwidgets='1' showaddelement='false')
            b:widget(id='LinkList1' type='LinkList' title='Navigation' version='2' locked='true')
              b:includable(id='main')
                +fcdNavList(false)
        form#site-search.search-form(action=fixture ? '/search' : undefined expr:action=fixture ? undefined : 'data:blog.searchUrl' method='get' role='search')
          label.sr-only(for='search-query') Search articles
          input#search-query(type='search' name='q' placeholder='Search security insights' autocomplete='off')/
          button(type='submit') Search blog

//- L2-intro (design v1): the first home page opens with an ink band. The theme owns the headline, so
//- every view keeps exactly one h1; the owner's Intro gadget copy (Layout > Intro) replaces the
//- default standfirst, and the Topics section follows inside the band.
mixin fcdIntroHero()
  header.intro-hero
    p.eyebrow Fast Cyber Defense Blog
    h1#intro-heading Security knowledge. Practical defense.

mixin fcdIntroCopy(fixture)
  .intro-body
    if fixture
      p.standfirst Research, threat insights, and guidance for stronger security.
    else
      b:if(cond='data:content')
        b:eval(expr='data:content')/
        b:else/
        p.standfirst Research, threat insights, and guidance for stronger security.

mixin fcdIntroBand(fixture = false, home = false)
  .intro-band
    if fixture
      if home
        +fcdIntroHero()
      #intro.intro
        #HTML1.widget.HTML
          if home
            +fcdIntroCopy(true)
    else
      b:if(cond='data:view.isHomepage and not data:newerPageUrl')
        +fcdIntroHero()
      b:section(id='intro' class='intro' name='Intro' maxwidgets='1' showaddelement='false')
        b:widget(id='HTML1' type='HTML' title='Intro' version='2' locked='true')
          b:includable(id='main')
            b:if(cond='data:view.isHomepage and not data:newerPageUrl')
              +fcdIntroCopy(false)
    if block
      block

//- L3-CTA (design v1): one sitewide call to action between the content and the footer. The owner's
//- Call to Action gadget copy (Layout > Call to Action) replaces the default message and button.
mixin fcdCtaDefault()
  .cta-copy
    h2 Need help securing your organization?
    p Put knowledge into practice with Fast Cyber Defense.
  a.cta-button(href='https://fastcyberdefense.com/') Explore FCD services
    span.cta-external(aria-hidden='true') &#8599;

mixin fcdCtaBand(fixture = false)
  aside.cta-band(aria-label='Call to action')
    .container
      if fixture
        #cta.cta
          #HTML2.widget.HTML
            .cta-row
              +fcdCtaDefault()
      else
        b:section(id='cta' class='cta' name='Call to Action' maxwidgets='1' showaddelement='false')
          b:widget(id='HTML2' type='HTML' title='Call to Action' version='2' locked='true')
            b:includable(id='main')
              .cta-row
                b:if(cond='data:content')
                  .cta-copy
                    b:eval(expr='data:content')/
                  b:else/
                  +fcdCtaDefault()

//- L4-footer (design v1): the brand and the owner's Footer gadget copy (Layout > Footer) on the left,
//- theme-owned links on the right, then a base row with the copyright and the compact native gadgets.
mixin fcdFooterCopy()
  p.footer-tagline Quick to Act, Strong to Protect.
  p.footer-blurb Security research and practical guidance from Fast Cyber Defense.

mixin fcdFooter(fixture = false)
  footer.site-footer
    .container.footer-grid
      .footer-brand
        p.brand-name Fast Cyber Defense
        if fixture
          #footer.footer-copy
            #HTML3.widget.HTML
              .footer-text
                +fcdFooterCopy()
        else
          b:section(id='footer' class='footer-copy' name='Footer' maxwidgets='1' showaddelement='false')
            b:widget(id='HTML3' type='HTML' title='Footer' version='2' locked='true')
              b:includable(id='main')
                .footer-text
                  b:if(cond='data:content')
                    b:eval(expr='data:content')/
                    b:else/
                    +fcdFooterCopy()
      nav.footer-links(aria-label='Footer')
        a.footer-link(href='https://fastcyberdefense.com/') Company website
          span.footer-external(aria-hidden='true') &#8599;
        a.footer-link(href=fixture ? '/feeds/posts/default' : undefined expr:href=fixture ? undefined : 'data:blog.homepageUrl path "feeds/posts/default"') Publication feed
        a.footer-link(href='#top') Back to top
    .container.footer-base
      p.footer-copyright &#169; Fast Cyber Defense
      if block
        block

mixin fcdLabels(post, fixture)
  if fixture
    if post.labels && post.labels.length
      .post-labels
        each label in post.labels
          a(href=label.url rel='tag')= label.name
  else
    b:if(cond='data:post.labels')
      .post-labels
        b:loop(values='data:post.labels' var='label' index='li')
          b:if(cond='data:view.isSingleItem or data:li < 2')
            a(expr:href='data:label.url' rel='tag')
              b:eval(expr='data:label.name')/

mixin fcdByline(post, fixture, single)
  .byline
    if fixture
      span= post.author
      time(datetime=post.date)= post.dateLabel
      if single
        if post.updated
          span Updated
            time(datetime=post.updated)= post.updatedLabel
        span#reading-time(hidden='hidden')
    else
      b:if(cond='data:post.author.name')
        span
          b:eval(expr='data:post.author.name')/
      b:if(cond='data:post.date')
        time(expr:datetime='data:post.date.iso8601')
          b:eval(expr='data:post.date')/
      b:if(cond='data:view.isPost and data:post.lastUpdated')
        span Updated
          time(expr:datetime='data:post.lastUpdated.iso8601')
            b:eval(expr='data:post.lastUpdated')/
      b:if(cond='data:view.isPost')
        span#reading-time(hidden='hidden')

mixin fcdCardImage(post, fixture)
  - var lead = fixture && post.role === 'lead'
  a.card-image(href=fixture ? post.url : undefined expr:href=fixture ? undefined : 'data:post.url' aria-hidden='true' tabindex='-1')
    img(src=fixture ? post.image : undefined srcset=fixture ? post.image+' 400w, '+post.image+' 800w, '+post.image+' 1200w' : undefined expr:src=fixture ? undefined : 'resizeImage(data:post.featuredImage, 800, "16:9")' expr:srcset=fixture ? undefined : 'resizeImage(data:post.featuredImage, 400, "16:9") + " 400w, " + resizeImage(data:post.featuredImage, 800, "16:9") + " 800w, " + resizeImage(data:post.featuredImage, 1200, "16:9") + " 1200w"' sizes='(max-width: 639px) calc(100vw - 2rem), (max-width: 1023px) 65vw, 640px' width='800' height='450' alt='' decoding='async' loading=fixture ? (lead ? 'eager' : 'lazy') : undefined fetchpriority=fixture ? (lead ? 'high' : 'auto') : undefined expr:loading=fixture ? undefined : 'data:fcdEditorialRole == "lead" ? "eager" : "lazy"' expr:fetchpriority=fixture ? undefined : 'data:fcdEditorialRole == "lead" ? "high" : "auto"')/

mixin fcdCard(post = {}, fixture = false)
  article.post-card(data-filter-card='true' data-editorial-role=fixture ? (post.role || 'standard') : undefined expr:data-editorial-role=fixture ? undefined : 'data:fcdEditorialRole')
    if fixture
      if post.image
        +fcdCardImage(post, true)
    else
      b:if(cond='data:post.featuredImage')
        +fcdCardImage({}, false)
    .card-content
      +fcdLabels(post, fixture)
      h2.post-title
        a(href=fixture ? post.url : undefined expr:href=fixture ? undefined : 'data:post.url')
          if fixture
            = post.title
          else
            b:eval(expr='data:post.title')/
      p.post-excerpt
        if fixture
          = post.excerpt
        else
          b:eval(expr='snippet(data:post.snippets.long, {length: 180, links: false, linebreaks: false, ellipsis: true})')/
      +fcdByline(post, fixture, false)

mixin fcdRelated(post, fixture)
  section.related-articles(data-related-post='true' aria-labelledby='related-heading' data-post-url=fixture ? post.url : undefined data-post-id=fixture ? post.id : undefined expr:data-post-url=fixture ? undefined : 'data:post.url.canonical' expr:data-post-id=fixture ? undefined : 'data:post.id')
    h2#related-heading(data-related-heading='true') Continue reading
    ol.related-list(data-related-list='true')
    p(data-related-status='true') Explore more publications and topics.
    a.related-fallback(href=fixture ? '/search' : undefined expr:href=fixture ? undefined : 'data:blog.homepageUrl path "search"') Browse latest articles
    +fcdLabels(post, fixture)
    div(hidden='hidden')
      if fixture
        each label in (post.labels || []).slice(0,20)
          span(data-current-label=label.name)
      else
        b:loop(values='data:post.labels take 20' var='relatedLabel')
          span(expr:data-current-label='data:relatedLabel.name')

mixin fcdShare(post, fixture)
  .share-actions(aria-label='Share article')
    button.js-control#copy-link(type='button' hidden='hidden') Copy article link
    a(href=fixture ? 'https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent('https://blogs.fastcyberdefense.com'+post.url) : undefined expr:href=fixture ? undefined : '"https://www.linkedin.com/sharing/share-offsite/" params {url: data:post.url.canonical}' target='_blank' rel='noopener noreferrer') Share on LinkedIn

mixin fcdArticle(post = {}, fixture = false)
  article.article-view
    header.article-header
      +fcdLabels(post, fixture)
      h1.post-title
        if fixture
          = post.title
        else
          b:eval(expr='data:post.title')/
      +fcdByline(post, fixture, true)
      if fixture
        if post.excerpt
          p.standfirst= post.excerpt
      else
        b:if(cond='data:view.description')
          p.standfirst
            b:eval(expr='data:view.description')/
    .post-body#article-body
      if fixture
        block
      else
        b:eval(expr='data:post.body')/
    if fixture
      if post.isPost !== false
        +fcdRelated(post, true)
        +fcdShare(post, true)
    else
      b:if(cond='data:view.isPost')
        +fcdRelated({}, false)
        +fcdShare({}, false)

//- Copy and recovery markup are shared; Blogger decides native state at render time.
//- Fixture state selection is a simulation, not an evaluator of Blogger expressions.
mixin fcdEmptyPanel(state, fixture = false, context = '')
  - var titles = {error:'Page not found',label:'No articles under this label',search:'No matching articles',archive:'No articles in this period',home:'No articles published yet',generic:'No articles on this page'}
  - var descriptions = {error:'The page may have moved or the address may be incorrect.',label:'Try another topic or search the publication.',search:'Try fewer words or a different search term.',archive:'Try another period or search the publication.',home:'New security research will appear here when it is published.',generic:'Return to the publication or try a different search.'}
  - var nativeContext = {label:'data:view.search.label',search:'data:view.search.query',archive:'data:view.archive.rangeMessage'}
  section.empty-state(data-empty-state=state)
    h2= titles[state]
    p= descriptions[state]
    if nativeContext[state]
      if fixture
        if context
          p.empty-context= context
      else
        b:if(cond=nativeContext[state])
          p.empty-context
            b:eval(expr=nativeContext[state]+'.escaped')/
    form.search-form(action=fixture ? '/search' : undefined expr:action=fixture ? undefined : 'data:blog.searchUrl' method='get' role='search' aria-label='Recovery search')
      label.sr-only(for='empty-state-query-'+state) Search the publication
      input(id='empty-state-query-'+state type='search' name='q' placeholder='Search the publication')/
      button(type='submit') Search
    p
      a(href=fixture ? '/' : undefined expr:href=fixture ? undefined : 'data:blog.homepageUrl') Return to publication

mixin fcdEmptyState(fixture = false, state = 'generic', context = '')
  if fixture
    +fcdEmptyPanel(state, true, context)
  else
    b:if(cond='data:view.isError')
      +fcdEmptyPanel('error')
      b:elseif(cond='data:view.isLabelSearch')/
      +fcdEmptyPanel('label')
      b:elseif(cond='data:view.isSearch')/
      +fcdEmptyPanel('search')
      b:elseif(cond='data:view.isArchive')/
      +fcdEmptyPanel('archive')
      b:elseif(cond='data:view.isHomepage and not data:newerPageUrl')/
      +fcdEmptyPanel('home')
      b:else/
      +fcdEmptyPanel('generic')
