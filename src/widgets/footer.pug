footer.site-footer
  .container.footer-grid
    div
      p.brand-name Fast Cyber Defense
      p Quick to Act, Strong to Protect.
    nav(aria-label='Company and publication')
      a(href='https://fastcyberdefense.com/') Company website
      a(expr:href='data:blog.homepageUrl path "feeds/posts/default"') Publication feed
      a(href='#content') Back to content
  .container.footer-note Security research and practical guidance from Fast Cyber Defense.
  b:section(id='footer-gadgets' class='footer-gadgets' name='Footer gadgets' showaddelement='false')
    b:widget(id='Attribution1' type='Attribution' title='' version='2' locked='true')
      b:includable(id='main' var='this')
        b:include(name='super.main')/
    b:widget(id='ReportAbuse1' type='ReportAbuse' title='' version='2' locked='false')
      b:includable(id='main' var='this')
        b:include(name='super.main')/
